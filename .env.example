# 3D ULPIN System Environment Configuration & API Keys
# Core features operate 100% out-of-the-box using built-in free endpoints!

# Server Port & Mode
PORT=8000
ENVIRONMENT=development

# Optional Mapbox Access Token (for high-resolution 3D terrain mesh & Mapbox Satellite tiles)
# Obtain free token at https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=

# Optional OpenTopography API Key (for high-density global LiDAR point cloud downloads)
# Obtain free key at https://opentopography.org/
OPENTOPOGRAPHY_API_KEY=

# Optional Google Earth Engine / Copernicus Cloud Credentials
GEE_SERVICE_ACCOUNT=
